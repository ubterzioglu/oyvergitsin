# Public browser-readable configuration
NEXT_PUBLIC_SITE_URL=https://oyvergitsin.org
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only secrets. Do not prefix these with NEXT_PUBLIC_ and do not expose
# them to client bundles. SESSION_HASH_SECRET is required in production.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SESSION_HASH_SECRET=replace_with_32_plus_random_bytes_hex


# Admin seed and username login alias. ADMIN_SEED_PASSWORD is used only by
# npm run db:seed:admin to create/update the Supabase Auth password.
ADMIN_USERNAME=oyvergitsin
ADMIN_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_strong_admin_password

# Write-capable E2E/smoke tests are allowed only on localhost by default. Set to
# true only for a dedicated, non-production test environment.
ALLOW_REMOTE_TEST_WRITES=false

# Party registry v2 rollout. Keep false until registry_status/match_status
# migration and party coverage validation are complete in the target database.
PARTY_MATCH_STATUS_FILTER_ENABLED=false

# Radar cron scan secret — 32+ char hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret

# Zoho Mail SMTP (feedback email notifications) — use an app-specific password,
# generated in Zoho Mail > Settings > Security > App Passwords.
# EU accounts use smtp.zoho.eu; .com accounts use smtp.zoho.com.
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_USER=your_mailbox@oyvergitsin.org
ZOHO_SMTP_PASSWORD=your_zoho_app_password
FEEDBACK_NOTIFICATION_EMAIL=admin@example.com
