# Production Environment Variables for Coolify
# Copy this file and set your actual values in Coolify's dashboard

# Supabase Configuration (Required)
NEXT_PUBLIC_SITE_URL=https://oyvergitsin.org
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SESSION_HASH_SECRET=replace_with_32_plus_random_bytes_hex

# Admin Login
ADMIN_USERNAME=oyvergitsin
ADMIN_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace_with_strong_admin_password

# Party Registry v2
PARTY_MATCH_STATUS_FILTER_ENABLED=false

# Siyaset Radarı scheduled feed
CRON_SECRET=replace_with_32_plus_random_bytes_hex
GNEWS_API_KEY=your_gnews_api_key
GNEWS_MAX_ARTICLES=10
GNEWS_LOOKBACK_HOURS=48

# Application Configuration (Optional)
# NODE_ENV=production
# PORT=3000
